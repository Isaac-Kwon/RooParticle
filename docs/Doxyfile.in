# Doxyfile template, filled in by cmake/Doxygen.cmake (configure_file, @ONLY).
# Only settings that differ from the Doxygen defaults are listed.

PROJECT_NAME           = "RooParticle"
PROJECT_BRIEF          = "Particle scattering simulator with ROOT"
# default is the current directory
OUTPUT_DIRECTORY       = @RP_DOC_OUTPUT_DIR@
# the headers have few doc comments yet; the public API must still show up
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
# inputs (TODO.md and test/README.md only so that links in README.md resolve)
INPUT                  = @RP_SOURCE_DIR@/include @RP_SOURCE_DIR@/src @RP_SOURCE_DIR@/docs @RP_SOURCE_DIR@/README.md @RP_SOURCE_DIR@/TODO.md @RP_SOURCE_DIR@/test/README.md
FILE_PATTERNS          = *.hpp *.cpp *.md
# docs/README.md is a note for writers, not part of the manual
EXCLUDE                = @RP_SOURCE_DIR@/docs/README.md
# \include and \snippet look for compilable examples here
EXAMPLE_PATH           = @RP_SOURCE_DIR@/test
EXAMPLE_PATTERNS       = *.cpp *.hpp
# the front page is docs/mainpage.md (root README.md stays a normal page)
USE_MDFILE_AS_MAINPAGE = @RP_SOURCE_DIR@/docs/mainpage.md
# source browsing: listings with cross-references
SOURCE_BROWSER         = YES
# formulas such as the Rutherford relation
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
# HTML only
GENERATE_LATEX         = NO
# warnings go to a file in the build dir, not the terminal
WARN_LOGFILE           = @RP_DOC_OUTPUT_DIR@/doxygen-warnings.log
QUIET                  = YES
# graphs only when CMake found graphviz
HAVE_DOT               = @RP_HAVE_DOT@
COLLABORATION_GRAPH    = NO
